{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://htsvoice-repo.alcnaka.com/schema/voice.schema.json",
  "title": "htsvoice-repo voice metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "description", "language", "locale", "publisher", "license", "releases"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "locale": {"type": "string", "minLength": 2},
    "publisher": {"type": "string", "minLength": 1},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "name", "url"],
      "properties": {
        "spdx": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"text": {"type": "string"}}
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/release"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "name": {"type": "string", "minLength": 1},
        "style": {"type": "string"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "homepage", "distribution", "filename", "mirror", "license_path"],
      "properties": {
        "kind": {"enum": ["zip", "tar.gz"]},
        "url": {"type": "string", "format": "uri"},
        "homepage": {"type": "string", "format": "uri"},
        "distribution": {"type": "string", "format": "uri"},
        "filename": {"type": "string", "minLength": 1},
        "mirror": {"type": "boolean"},
        "license_path": {"type": "string", "minLength": 1},
        "strip_components": {"type": "integer", "minimum": 0},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "git_commit": {"$ref": "#/$defs/gitSha"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "upstream_version", "revision", "status", "source", "variants"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._+-]+$"},
        "upstream_version": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "status": {"enum": ["pending", "current", "superseded", "deprecated", "withdrawn"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "source": {"$ref": "#/$defs/source"},
        "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variant"}}
      }
    }
  }
}
